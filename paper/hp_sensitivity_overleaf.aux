\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The flexibility of \eqref  {eq:flex-energy} over one cycle of the square-wave schedule. The aggregate must draw the baseline energy $E^{\mathrm  {old}}_{\mathrm  {TCL}} = \hat  {P}_{\mathrm  {TCL}}(T)\,\Delta t_{Th}$ (hatched) over the window. It can instead draw the same energy as the full-power pulse $P^{\mathrm  {new}}_{\mathrm  {TCL}}$ of duty cycle $\alpha _F = \hat  {\mathrm  {SF}}(T)$. The deviation from baseline is the flexible energy, equal upward ($E_{\mathrm  {flex}}^{\uparrow }$) and downward ($E_{\mathrm  {flex}}^{\downarrow }$).}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:flex-schedule}{{4}{6}{The flexibility of \eqref {eq:flex-energy} over one cycle of the square-wave schedule. The aggregate must draw the baseline energy $E^{\mathrm {old}}_{\mathrm {TCL}} = \hat {P}_{\mathrm {TCL}}(T)\,\Delta t_{Th}$ (hatched) over the window. It can instead draw the same energy as the full-power pulse $P^{\mathrm {new}}_{\mathrm {TCL}}$ of duty cycle $\alpha _F = \hat {\mathrm {SF}}(T)$. The deviation from baseline is the flexible energy, equal upward ($E_{\mathrm {flex}}^{\uparrow }$) and downward ($E_{\mathrm {flex}}^{\downarrow }$)}{figure.4}{}}
\newlabel{eq:flex-energy}{{13}{6}{Flexibility Quantification}{equation.13}{}}
